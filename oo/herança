# Classe Pai (Superclasse ) - Generalista
class Game:
   total_games = 0
   def __init__(self, name='', yearLaunch=0, multiplayer=0, note=0.0):
        self.name = name
        self.yearLaunch = yearLaunch
        self.multiplayer = multiplayer
        self.note = note
        Game.total_games += 1
        self.totalEvaluation = 0
        self.evaluators = 0

   def __str__(self):
      return f'Game: {self.name}'
   
   def technical_sheet(self):
       print(f'###Dados do Jogo###')
       print(f'NOme do Jogo: {self.name}')
       print(f'Ano de Lançamento: {self.yearLaunch}')
       print(f'Multiplayer: {self.multiplayer}')
       print(f'Avlaiação do Jogo: {self.note}\n')
   
   def evaluate(self, note):
       self.totalEvaluation += note
       self.evaluators += 1

   def average(self):
       print(f'Média do Jogo {self.name}: {self.totalEvaluation / self.evaluators}')

# classe derivada (Subclasse) - Especializada
class SinglePlayerGame(Game):
    def __init__(self, name='', yearLaunch=0, note=0.0, storyLine=''):
        super().__init__(name, yearLaunch, multiplayer=False, note=note)
        self.storyLine = storyLine

    def technical_sheet(self):
        super().technical_sheet()
        print(f'Enredo: {self.storyLine}\n')

mult_game = Game('Fortinite', 2017, True, 8.0)
mult_game.technical_sheet()

sing_game = SinglePlayerGame('The last of Us 2', 2020, 9.5, "Emocionante hostória de sobrevivência e vingança.")
sing_game.technical_sheet()
